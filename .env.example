# --- Inférence : OpenRouter (API compatible OpenAI, appelée via LangChain) ---
OPENROUTER_API_KEY=
# Modèle Gemma 26B ; vérifier l'identifiant exact dans le catalogue OpenRouter.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.3
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TIMEOUT_MS=45000
# En-têtes d'attribution OpenRouter (facultatifs)
APP_URL=http://localhost:3000
APP_NAME=Assistant VE

# --- Persistance (fichier JSON) ---
# Par défaut : ./.data en local, /tmp/assistant-ve sur Vercel (non durable).
# DATA_DIR=

# --- Vérification du numéro ---
# true : aucun SMS envoyé, le code de démonstration est affiché dans l'interface.
OTP_DEMO_MODE=true
OTP_DEMO_CODE=123456

# --- Authentification contournée : utilisateur de démonstration ---
DEMO_USER_ID=demo-user
DEMO_USER_FIRSTNAME=[Prénom]
DEMO_USER_LASTNAME=[Nom]
